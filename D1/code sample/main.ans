# Declare elements
element H {
    atomic_mass = 1.008,
    valence = 1,
    symbol = "H"
};
element O {
    atomic_mass = 15.999,
    valence = 2,
    symbol = "O"
};
element C {
    atomic_mass = 12.011,
    valence = 4,
    symbol = "C"
};

# Declare compounds
compound water {
    formula = H2O,
    name = "Water"
};
compound methane {
    formula = CH4,
    name = "Methane"
};
compound co2 {
    formula = CO2,
    name = "Carbon dioxide"
};
compound oxygen {
    formula = O2,
    name = "Oxygen"
};

# Declare variables
let num = 20;
let name = "Hydrogen";
let char = 'H';
let elements = [H, O, C];
let n = 21.2;
let list = [1, "two", 3.45, 4, 5, water, methane.formula, co2.name, H];

# Function declaration for computing yield of a compound in a reaction
function compute_yield(reaction, mol, compound) {
    let products = reaction.products;
    let reactants = reaction.reactants;
    let reactant_mol = mol / reactants[compound].mol;
    let product_mol = reactant_mol * products[compound].mol;
    return product_mol;
};

# Function declaration for computing molar mass of a compound
function molar_mass(compound) {
    let formula = compound.formula;
    let mass = 0.0;
    for (let element in formula) {
        mass += element.atomic_mass * formula[element];
    }
    return mass;
};

# Declare a reaction and verify it is balanced at compile time
reaction combustion {
    reactants = CH4 + 2*O2,
    products = CO2 + 2*H2O,
    check = balanced,
    energy = exothermic 890.3 kJ/mol
};

reaction combustion2 {
    reactants = methane + 2*oxygen,
    products = co2 + 2*water,
    check = balanced,
    energy = exothermic 890.3 kJ/mol
};

# Stoichiometric query
molar_mass(water);
compute_yield(combustion, 5.0 mol, CH4);

# if statements
if compute_yield(combustion, 5.0 mol, CH4) > 0 {
    print "The yield of CH4 is positive, so combustion is possible.";
}
elif compute_yield(combustion, 5.0 mol, CH4) == 0 {
    print "The yield of CH4 is zero, so combustion is not possible.";
}
else {
    print "The yield of CH4 is negative, so combustion is not possible.";
}
